#!/usr/bin/env bash
# Create a Regression Defect in Jira (NO parent, Issue Type: Defect, HAS labels, HAS prefix)
#
# Usage: ./bin/create-regression-defect --module GiftCard --env preprod --platform WebApp --priority p1
#
# Required: --module
# Optional: --env (preprod|staging|prod), --platform (WebApp|iOS|Android|SuperApp), --priority (p0|p1|p2|p3)
#
# Rules:
# - Issue Type: Defect
# - NO parent field
# - HAS labels: ["regression-testing", "Regression-testing"]
# - Summary prefix: "Regression - {ENV} - {PLATFORM} - {Title}"
#
# Interactive prompt: "Enter defect description:" (used as seed for auto-generated fields)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"
exec "$SCRIPT_DIR/venv/bin/python3" main.py create-regular-defect "$@"
